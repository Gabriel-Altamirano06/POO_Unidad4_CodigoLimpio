<mxfile host="app.diagrams.net">
  <diagram name="Página-1" id="WwjmhIbezLJmjoDtCbDa">
    <mxGraphModel dx="4343" dy="2287" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nclassDiagram\ndirection TB\n\nnamespace MODELO {\n    class ContenidoAudiovisual {\n        &lt;&lt;abstract&gt;&gt;\n        +getId() int\n        +getTitulo() String\n        +getDuracionEnMinutos() int\n        +getGenero() String\n        +restaurarIdentificador(id) void\n        +mostrarDetalles() void\n    }\n\n    class Pelicula {\n        +getEstudio() String\n        +getActores() List\n        +agregarActor(actor) void\n    }\n\n    class SerieDeTV {\n        +getListaTemporadas() List\n        +agregarTemporada(numero, anio, episodios) void\n    }\n\n    class Documental {\n        +getTema() String\n        +getInvestigadores() List\n        +agregarInvestigador(investigador) void\n    }\n\n    class VideoMusical {\n        +getArtistaPrincipal() String\n        +getSelloDiscografico() String\n        +getAnioLanzamiento() int\n        +getActoresParticipantes() List\n        +agregarActorParticipante(actor) void\n    }\n\n    class ConferenciaCientifica {\n        +getTemaCentral() String\n        +getInstitucionOrganizadora() String\n        +getFechaRealizacion() String\n        +getModalidad() String\n        +getInvestigadores() List\n        +agregarInvestigador(investigador) void\n    }\n\n    class Actor {\n        -nombre String\n        -nacionalidad String\n        -edad int\n    }\n\n    class Temporada {\n        -numeroTemporada int\n        -anioEstreno int\n        -numeroEpisodios int\n    }\n\n    class Investigador {\n        -nombre String\n        -especialidad String\n        -institucion String\n    }\n}\n\nnamespace VISTA {\n    class ContenidoVista {\n        -entrada Scanner\n        +mostrarMenu() void\n        +leerOpcion() int\n        +mostrarMensaje(mensaje) void\n        +mostrarContenidos(contenidos) void\n        +leerIdentificador() int\n        +leerTexto(mensaje) String\n        +leerEntero(mensaje) int\n        +leerPositivo(mensaje) int\n        +leerCantidad(mensaje) int\n    }\n}\n\nnamespace CONTROLADOR {\n    class ContenidoController {\n        -contenidos List\n        -escritor ContenidoWriter\n        +ContenidoController(repositorio)\n        +ContenidoController(lector, escritor)\n        +registrarContenido(contenido) void\n        +obtenerContenidos() List\n        +buscarContenido(id) ContenidoAudiovisual\n        +eliminarContenido(id) boolean\n        +obtenerCantidad() int\n    }\n\n    class SistemaAudiovisualController {\n        -gestor ContenidoController\n        -vista ContenidoVista\n        +iniciar() void\n        -procesarOpcion(opcion) void\n        -registrarPelicula() void\n        -registrarSerie() void\n        -registrarDocumental() void\n        -registrarVideoMusical() void\n        -registrarConferencia() void\n        -registrarYGuardar(contenido) void\n        -buscarContenido() void\n        -eliminarContenido() void\n    }\n}\n\nnamespace PERSISTENCIA {\n    class ContenidoReader {\n        &lt;&lt;interface&gt;&gt;\n        +cargar() List\n    }\n\n    class ContenidoWriter {\n        &lt;&lt;interface&gt;&gt;\n        +guardar(contenidos) void\n    }\n\n    class ContenidoRepository {\n        &lt;&lt;interface&gt;&gt;\n    }\n\n    class CsvContenidoRepository {\n        -carpetaDatos Path\n        -archivoContenidos Path\n        -archivoActores Path\n        -archivoTemporadas Path\n        -archivoInvestigadores Path\n        +cargar() List\n        +guardar(contenidos) void\n    }\n}\n\nnamespace APLICACION {\n    class SistemaAudiovisualApp {\n        +main(args) void\n    }\n}\n\nnamespace PRUEBAS {\n    class CsvContenidoRepositoryTest {\n        +guardarYCargarTodosLosTiposDeContenido() void\n        +cargarSinArchivosDevuelveListaVacia() void\n        +cargarConIdentificadorIncorrectoLanzaExcepcion() void\n    }\n\n    class ContenidoControllerTest {\n        +registrarContenidoCorrectamente() void\n        +buscarContenidoPorIdentificador() void\n        +eliminarContenidoCorrectamente() void\n        +rechazarContenidoNulo() void\n        +restaurarListaCuandoFallaElRegistro() void\n        +restaurarContenidoCuandoFallaLaEliminacion() void\n        +eliminarIdentificadorInexistente() void\n    }\n}\n\nnamespace LEGADO {\n    class SistemaAudiovisual {\n        &lt;&lt;legacy&gt;&gt;\n        Menu anterior del deber 2\n    }\n}\n\nContenidoAudiovisual &lt;|-- Pelicula\nContenidoAudiovisual &lt;|-- SerieDeTV\nContenidoAudiovisual &lt;|-- Documental\nContenidoAudiovisual &lt;|-- VideoMusical\nContenidoAudiovisual &lt;|-- ConferenciaCientifica\n\nPelicula \&quot;1\&quot; *-- \&quot;0..*\&quot; Actor : actores\nVideoMusical \&quot;1\&quot; *-- \&quot;0..*\&quot; Actor : participantes\nSerieDeTV \&quot;1\&quot; *-- \&quot;0..*\&quot; Temporada : temporadas\nDocumental \&quot;1\&quot; *-- \&quot;0..*\&quot; Investigador : investigadores\nConferenciaCientifica \&quot;1\&quot; *-- \&quot;0..*\&quot; Investigador : investigadores\n\nContenidoReader &lt;|-- ContenidoRepository\nContenidoWriter &lt;|-- ContenidoRepository\nContenidoRepository &lt;|.. CsvContenidoRepository\n\nContenidoController ..&gt; ContenidoReader : lectura\nContenidoController ..&gt; ContenidoWriter : escritura\nContenidoController --&gt; ContenidoAudiovisual : administra\n\nSistemaAudiovisualController --&gt; ContenidoController : coordina\nSistemaAudiovisualController --&gt; ContenidoVista : utiliza\nSistemaAudiovisualController ..&gt; ContenidoRepository : inyeccion\n\nSistemaAudiovisualApp --&gt; SistemaAudiovisualController : inicia\n\nCsvContenidoRepository ..&gt; ContenidosCSV : almacena\nclass ContenidosCSV {\n    &lt;&lt;files&gt;&gt;\n    contenidos.csv\n    actores.csv\n    temporadas.csv\n    investigadores.csv\n}\n\nCsvContenidoRepositoryTest ..&gt; CsvContenidoRepository : prueba\nContenidoControllerTest ..&gt; ContenidoController : prueba\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="d2H9Zc-fnFDRnG4Xd-0_-1">
