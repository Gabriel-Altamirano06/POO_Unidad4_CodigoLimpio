  <diagram name="Página-1" id="n95sY1Vmhz38AiACPLDD">
    <mxGraphModel dx="4343" dy="2287" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nclassDiagram\ndirection TB\n\nnamespace MODELO {\n    class ContenidoAudiovisual {\n        &lt;&lt;abstract&gt;&gt;\n        -id int\n        -titulo String\n        -duracionEnMinutos int\n        -genero String\n        +getId() int\n        +getTitulo() String\n        +getDuracionEnMinutos() int\n        +getGenero() String\n        +restaurarIdentificador(id) void\n    }\n    class Pelicula\n    class SerieDeTV\n    class Documental\n    class VideoMusical\n    class ConferenciaCientifica\n    class Actor\n    class Temporada\n    class Investigador\n}\n\nnamespace VISTA {\n    class ContenidoVista {\n        -entrada Scanner\n        +mostrarMenu() void\n        +leerOpcion() int\n        +mostrarMensaje(mensaje) void\n        +mostrarContenidos(contenidos) void\n        +mostrarDetalleContenido(contenido) void\n        +leerTexto(mensaje) String\n        +leerEntero(mensaje) int\n    }\n}\n\nnamespace CONTROLADOR {\n    class ContenidoController {\n        -contenidos List\n        -escritor ContenidoWriter\n        +registrarContenido(contenido) void\n        +obtenerContenidos() List\n        +buscarContenido(id) ContenidoAudiovisual\n        +eliminarContenido(id) boolean\n        +obtenerCantidad() int\n    }\n\n    class SistemaAudiovisualController {\n        -gestor ContenidoController\n        -vista ContenidoVista\n        +iniciar() void\n        -procesarOpcion(opcion) void\n        -registrarYGuardar(contenido) void\n    }\n}\n\nnamespace PERSISTENCIA {\n    class ContenidoReader {\n        &lt;&lt;interface&gt;&gt;\n        +cargar() List\n    }\n    class ContenidoWriter {\n        &lt;&lt;interface&gt;&gt;\n        +guardar(contenidos) void\n    }\n    class ContenidoRepository {\n        &lt;&lt;interface&gt;&gt;\n    }\n    class CsvContenidoRepository {\n        -carpetaDatos Path\n        -adaptadores List\n        -adaptadoresPorTipo Map\n        +cargar() List\n        +guardar(contenidos) void\n        +buscarAdaptador(contenido)\n    }\n}\n\nnamespace ADAPTADORES {\n    class ContenidoCsvAdapter {\n        &lt;&lt;interface&gt;&gt;\n        +obtenerTipo() String\n        +obtenerClase() Class\n        +obtenerDatosEspecificos(contenido) String\n        +crearContenido(datos) ContenidoAudiovisual\n        +obtenerFilasActores(contenido) List\n        +obtenerFilasTemporadas(contenido) List\n        +obtenerFilasInvestigadores(contenido) List\n    }\n    class PeliculaCsvAdapter\n    class SerieCsvAdapter\n    class DocumentalCsvAdapter\n    class VideoMusicalCsvAdapter\n    class ConferenciaCsvAdapter\n}\n\nnamespace APLICACION {\n    class SistemaAudiovisualApp {\n        +main(args) void\n    }\n}\n\nnamespace PRUEBAS {\n    class CsvContenidoRepositoryTest\n    class ContenidoControllerTest\n}\n\nContenidoAudiovisual &lt;|-- Pelicula\nContenidoAudiovisual &lt;|-- SerieDeTV\nContenidoAudiovisual &lt;|-- Documental\nContenidoAudiovisual &lt;|-- VideoMusical\nContenidoAudiovisual &lt;|-- ConferenciaCientifica\n\nPelicula \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Actor : actores\nVideoMusical \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Actor : participantes\nSerieDeTV \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Temporada : temporadas\nDocumental \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Investigador : investigadores\nConferenciaCientifica \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Investigador : investigadores\n\nContenidoRepository --|&gt; ContenidoReader\nContenidoRepository --|&gt; ContenidoWriter\nCsvContenidoRepository ..|&gt; ContenidoRepository\n\nContenidoCsvAdapter &lt;|.. PeliculaCsvAdapter\nContenidoCsvAdapter &lt;|.. SerieCsvAdapter\nContenidoCsvAdapter &lt;|.. DocumentalCsvAdapter\nContenidoCsvAdapter &lt;|.. VideoMusicalCsvAdapter\nContenidoCsvAdapter &lt;|.. ConferenciaCsvAdapter\n\nCsvContenidoRepository o-- \&quot;1..*\&quot; ContenidoCsvAdapter : utiliza\n\nContenidoController --&gt; ContenidoReader : lectura\nContenidoController --&gt; ContenidoWriter : escritura\nContenidoController --&gt; ContenidoAudiovisual : administra\n\nSistemaAudiovisualController --&gt; ContenidoController : coordina\nSistemaAudiovisualController --&gt; ContenidoVista : utiliza\nSistemaAudiovisualApp --&gt; SistemaAudiovisualController : inicia\n\nCsvContenidoRepository ..&gt; ARCHIVOS_CSV : persiste\n\nclass ARCHIVOS_CSV {\n    &lt;&lt;archivos&gt;&gt;\n    contenidos.csv\n    actores.csv\n    temporadas.csv\n    investigadores.csv\n}\n\nCsvContenidoRepositoryTest ..&gt; CsvContenidoRepository : prueba\nContenidoControllerTest ..&gt; ContenidoController : prueba\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="ECKXju21HXdFOJFpWoPp-1">
